<UserControl x:Class="ElCarbonazo.Desktop.Views.SecurityErrorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElCarbonazo.Desktop.ViewModels"
             x:DataType="vm:SecurityErrorViewModel"
             Background="{StaticResource ColorHuesoBrush}">
    <Border Width="620"
            Margin="32"
            Padding="32"
            CornerRadius="16"
            Background="{StaticResource ColorBeigeBrush}"
            BorderBrush="{StaticResource ColorVinoBrush}"
            BorderThickness="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel Spacing="16">
            <TextBlock Text="Conexión bloqueada por seguridad"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{StaticResource ColorVinoBrush}" />
            <TextBlock Text="{Binding Message}"
                       Foreground="{StaticResource ColorCarbónBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="No existe una opción para omitir la validación del certificado. Cierre la aplicación y contacte al administrador."
                       Foreground="{StaticResource ColorCarbónBrush}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
