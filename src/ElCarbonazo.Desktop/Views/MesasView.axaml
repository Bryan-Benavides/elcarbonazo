<UserControl x:Class="ElCarbonazo.Desktop.Views.MesasView"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElCarbonazo.Desktop.ViewModels"
             xmlns:models="using:ElCarbonazo.Desktop.Models"
             xmlns:converters="using:ElCarbonazo.Desktop.Converters"
             x:DataType="vm:MesasViewModel"
             Background="{StaticResource FondoPrincipalBrush}">
    <UserControl.Resources>
        <converters:EstadoMesaColorConverter x:Key="EstadoColor" />
        <converters:MesaSeleccionadaConverter x:Key="MesaSeleccionadaConverter" />
        <!-- Sin la plantilla genérica de SukiUI: evita su fondo de hover blanco. -->
        <ControlTheme x:Key="MesaButtonTheme" TargetType="ToggleButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="AccionMesaTheme" TargetType="Button">
            <Setter Property="Background" Value="#3F3F46" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#71717A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover"><Setter Property="Background" Value="#565660" /><Setter Property="BorderBrush" Value="#FF784E" /></Style>
            <Style Selector="^:pressed"><Setter Property="Background" Value="#26262A" /></Style>
            <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="#F3F4F6" /><Setter Property="BorderThickness" Value="2" /></Style>
            <Style Selector="^:disabled"><Setter Property="Background" Value="#303034" /><Setter Property="Foreground" Value="#A1A1AA" /><Setter Property="BorderBrush" Value="#52525B" /></Style>
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button"><Setter Property="Theme" Value="{StaticResource AccionMesaTheme}" /></Style>
        <Style Selector="Button.primario"><Setter Property="Background" Value="#9F3517" /><Setter Property="BorderBrush" Value="#D75630" /></Style>
        <Style Selector="ToggleButton.mesa">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.mesa:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.mesa:checked">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.mesa:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.tarjeta">
            <Setter Property="BorderBrush" Value="{StaticResource BordePanelBrush}" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="Border.tarjeta:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AcentoFuegoBrush}" />
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
        </Style>
        <Style Selector="Border.tarjeta.seleccionada">
            <Setter Property="BorderBrush" Value="{StaticResource AcentoFuegoBrush}" />
        </Style>
        <Style Selector="Border.tarjeta.enfocada">
            <Setter Property="BorderBrush" Value="{StaticResource AcentoFuegoBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="180,*">
        <Border Grid.Column="0" Background="{StaticResource FondoPanelBrush}" BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16,24">
                <StackPanel Spacing="4">
                    <TextBlock Text="EL CARBONAZO" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AcentoFuegoBrush}" />
                    <TextBlock Text="Gestión de salón" FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}" />
                </StackPanel>
                <Border Grid.Row="1" Margin="0,32,0,0" Padding="12,10" VerticalAlignment="Top" CornerRadius="6" Background="{StaticResource FondoPrincipalBrush}" BorderBrush="{StaticResource AcentoFuegoBrush}" BorderThickness="3,0,0,0">
                    <TextBlock Text="Mesas" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipalBrush}" />
                </Border>
                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipalBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Rol}" FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}" TextWrapping="Wrap" />
                    <Button Content="Cerrar sesión" Command="{Binding SolicitarCierreCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="24,20">
            <StackPanel Spacing="5">
                <TextBlock Text="Mapa de mesas" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                <TextBlock Text="Salón principal · Consulta de mesas" Foreground="{StaticResource TextoSecundarioBrush}" />
            </StackPanel>
            <Border Grid.Row="1" Margin="0,18,0,16" Padding="12,10" CornerRadius="6" Background="{StaticResource FondoPanelBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding EstadoConexion}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MensajeAccion}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                    <Button Content="He revisado las mesas" IsVisible="{Binding ResultadoIncierto}" IsEnabled="{Binding PuedeReconocer}" Command="{Binding ReconocerIncertidumbreCommand}" />
                    <Button Classes="primario" Content="Agrupar mesas" IsEnabled="{Binding PuedeIniciarGrupo}" Command="{Binding IniciarGrupoCommand}" HorizontalAlignment="Left" />
                    <StackPanel IsVisible="{Binding SeleccionandoGrupo}" Spacing="8">
                        <TextBlock Text="{Binding ContadorGrupo}" Foreground="{StaticResource TextoPrincipalBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Confirmar grupo" IsEnabled="{Binding PuedeConfirmarGrupo}" Command="{Binding CrearGrupoCommand}" />
                            <Button Content="Cancelar" Command="{Binding CancelarGrupoCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Mesas}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MesaDto">
                            <ToggleButton x:Name="MesaButton" Theme="{StaticResource MesaButtonTheme}" Classes="mesa" Width="210" Margin="0,0,12,12" Padding="0" HorizontalContentAlignment="Stretch"
                                    Command="{Binding #Root.((vm:MesasViewModel)DataContext).SeleccionarMesaCommand}"
                                    CommandParameter="{Binding}">
                            <ToggleButton.IsChecked>
                                <MultiBinding Converter="{StaticResource MesaSeleccionadaConverter}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="#Root.((vm:MesasViewModel)DataContext).MesaSeleccionada" />
                                    <Binding Path="#Root.((vm:MesasViewModel)DataContext).MesasSeleccionadasGrupo" />
                                </MultiBinding>
                            </ToggleButton.IsChecked>
                            <Border Classes="tarjeta" Classes.seleccionada="{Binding #MesaButton.IsChecked}"
                                    Classes.enfocada="{Binding #MesaButton.IsKeyboardFocusWithin}"
                                    MinHeight="150" Background="{StaticResource FondoPanelBrush}" BorderThickness="1" CornerRadius="7">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                                    </Transitions>
                                </Border.Transitions>
                                <Grid RowDefinitions="4,*">
                                    <Border Grid.Row="0" Background="{Binding Estado, Converter={StaticResource EstadoColor}}" CornerRadius="7,7,0,0" />
                                    <StackPanel Grid.Row="1" Margin="15,13" Spacing="8">
                                        <TextBlock Text="{Binding Numero, StringFormat='Mesa {0:00}'}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                                        <TextBlock Text="{Binding Capacidad, StringFormat='Capacidad: {0} personas'}" Foreground="{StaticResource TextoSecundarioBrush}" />
                                        <TextBlock Text="{Binding Estado, StringFormat='Estado: {0}'}" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipalBrush}" />
                                        <TextBlock Text="{Binding GrupoTexto}" FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer Grid.Column="1" Width="242" IsVisible="{Binding HayMesaSeleccionada}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Margin="12,0,0,0" Padding="16" VerticalAlignment="Top"
                    Background="{StaticResource FondoPanelBrush}"
                    BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="12">
                    <TextBlock Text="Detalle de mesa" Foreground="{StaticResource TextoSecundarioBrush}" FontSize="13" />
                    <TextBlock Text="{Binding DetalleTitulo}" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="21" FontWeight="Bold" />
                    <TextBlock Text="{Binding DetalleCapacidad}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetalleEstado}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                     <TextBlock Text="{Binding DetalleGrupo}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                     <Button Content="Reservar" IsEnabled="{Binding PuedeReservar}" Command="{Binding ReservarCommand}" HorizontalAlignment="Stretch" />
                     <Button Content="Ocupar" IsEnabled="{Binding PuedeOcupar}" Command="{Binding OcuparCommand}" HorizontalAlignment="Stretch" />
                      <Button Content="Liberar" IsEnabled="{Binding PuedeLiberar}" Command="{Binding SolicitarLiberacionCommand}" HorizontalAlignment="Stretch" />
                      <Button Content="Cerrar grupo" IsEnabled="{Binding PuedeCerrarGrupo}" Command="{Binding SolicitarCierreGrupoCommand}" HorizontalAlignment="Stretch" />
                      <StackPanel IsVisible="{Binding ConfirmarCierreGrupo}" Spacing="8">
                          <TextBlock Text="¿Confirmar el cierre de este grupo?" TextWrapping="Wrap" Foreground="{StaticResource TextoPrincipalBrush}" />
                          <Button Content="Confirmar cierre" Command="{Binding CerrarGrupoCommand}" />
                          <Button Content="Cancelar" Command="{Binding CancelarCierreGrupoCommand}" />
                      </StackPanel>
                    <Button Content="Cerrar detalle" Command="{Binding CerrarDetalleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Border>
            </ScrollViewer>
            </Grid>
        </Grid>
        <Border Grid.ColumnSpan="2" Background="#B0000000" IsVisible="{Binding ConfirmarLiberacion}" ZIndex="110">
            <Border Width="380" MaxWidth="380" Padding="24" CornerRadius="10" Background="{StaticResource FondoPanelBrush}"
                    BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="¿Liberar mesa?" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <TextBlock Text="{Binding DetalleTitulo}" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <TextBlock Text="Confirma solo si deseas dejar esta mesa libre. La API verificará si tiene una cuenta pendiente." TextWrapping="Wrap" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancelar" Command="{Binding CancelarLiberacionCommand}" />
                        <Button Classes="primario" Content="Liberar mesa" Command="{Binding LiberarCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border Grid.ColumnSpan="2" Background="#B0000000" IsVisible="{Binding ConfirmarCierre}" ZIndex="100">
            <Border Width="380" Padding="24" CornerRadius="10" Background="{StaticResource FondoPanelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock Text="¿Cerrar sesión?" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <TextBlock Text="Se detendrá la consulta de mesas y volverá al inicio de sesión." TextWrapping="Wrap" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancelar" Command="{Binding CancelarCierreCommand}" />
                        <Button Content="Cerrar sesión" Command="{Binding CerrarSesionCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
