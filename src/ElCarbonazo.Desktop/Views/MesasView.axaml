<UserControl x:Class="ElCarbonazo.Desktop.Views.MesasView"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElCarbonazo.Desktop.ViewModels"
             xmlns:models="using:ElCarbonazo.Desktop.Models"
             xmlns:views="using:ElCarbonazo.Desktop.Views"
             xmlns:converters="using:ElCarbonazo.Desktop.Converters"
             x:DataType="vm:MesasViewModel"
             Background="{StaticResource FondoPrincipalBrush}">
    <UserControl.Resources>
        <converters:EstadoMesaColorConverter x:Key="EstadoColor" />
        <converters:ConexionColorConverter x:Key="ConexionColor" />
        <converters:MesaSeleccionadaConverter x:Key="MesaSeleccionadaConverter" />
        <!-- Sin la plantilla genérica de SukiUI: evita su fondo de hover blanco. -->
        <ControlTheme x:Key="MesaButtonTheme" TargetType="ToggleButton">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
        <ControlTheme x:Key="AccionMesaTheme" TargetType="Button">
            <Setter Property="Background" Value="#3F3F46" />
            <Setter Property="Foreground" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="#71717A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover"><Setter Property="Background" Value="#565660" /><Setter Property="BorderBrush" Value="#FF784E" /></Style>
            <Style Selector="^:pressed"><Setter Property="Background" Value="#26262A" /></Style>
            <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="#F3F4F6" /><Setter Property="BorderThickness" Value="2" /></Style>
            <Style Selector="^:disabled"><Setter Property="Background" Value="#303034" /><Setter Property="Foreground" Value="#A1A1AA" /><Setter Property="BorderBrush" Value="#52525B" /></Style>
        </ControlTheme>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button"><Setter Property="Theme" Value="{StaticResource AccionMesaTheme}" /></Style>
        <Style Selector="Button.navegacion-cocina"><Setter Property="Background" Value="{StaticResource FondoPrincipalBrush}" /><Setter Property="BorderBrush" Value="{StaticResource AcentoFuegoBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="Button.navegacion-cocina:pointerover"><Setter Property="Background" Value="#3A3030" /><Setter Property="BorderBrush" Value="#FF784E" /></Style>
        <Style Selector="Button.navegacion-cocina:focus-visible"><Setter Property="BorderBrush" Value="{StaticResource TextoPrincipalBrush}" /><Setter Property="BorderThickness" Value="3,0,0,0" /></Style>
        <Style Selector="Button.primario"><Setter Property="Background" Value="#9F3517" /><Setter Property="BorderBrush" Value="#D75630" /></Style>
        <Style Selector="ToggleButton.mesa">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.mesa:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.mesa:checked">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.mesa:pressed">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.tarjeta">
            <Setter Property="BorderBrush" Value="{StaticResource BordePanelBrush}" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
        </Style>
        <Style Selector="Border.tarjeta:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AcentoFuegoBrush}" />
            <Setter Property="RenderTransform" Value="translateY(-3px)" />
        </Style>
        <Style Selector="Border.tarjeta.seleccionada">
            <Setter Property="BorderBrush" Value="{StaticResource AcentoFuegoBrush}" />
        </Style>
        <Style Selector="Border.tarjeta.enfocada">
            <Setter Property="BorderBrush" Value="{StaticResource TextoPrincipalBrush}" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="58,Auto,*">
        <Border Grid.Column="0" IsVisible="{Binding !MostrandoModulo}" Background="{StaticResource FondoPanelBrush}" BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="0,0,1,0">
            <Button Content="☰" FontSize="21" Margin="6,14,6,0" Padding="5,7" VerticalAlignment="Top"
                    Command="{Binding AlternarNavegacionCommand}" AutomationProperties.Name="{Binding TextoNavegacion}"
                    ToolTip.Tip="{Binding TextoNavegacion}" />
        </Border>
        <Border Grid.Column="1" IsVisible="{Binding !MostrandoModulo}" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                Width="{Binding AnchoNavegacion}" ClipToBounds="True"
                Background="{StaticResource FondoPanelBrush}" BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="0,0,1,0">
            <Border.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.2" /></Transitions></Border.Transitions>
            <Panel Width="200" HorizontalAlignment="Left" IsVisible="{Binding NavegacionAbierta}">
            <Grid RowDefinitions="Auto,*,Auto" Margin="16,24">
                <StackPanel Spacing="4">
                    <TextBlock Text="EL CARBONAZO" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AcentoFuegoBrush}" />
                    <TextBlock Text="Gestión de salón" FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,32,0,0" Spacing="8" VerticalAlignment="Top">
                    <Border Padding="12,10" CornerRadius="6" Background="{StaticResource FondoPrincipalBrush}" BorderBrush="{StaticResource AcentoFuegoBrush}" BorderThickness="3,0,0,0">
                        <TextBlock Text="Mesas" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipalBrush}" />
                    </Border>
                    <Button Classes="navegacion-cocina" Content="Cocina" Padding="12,10" IsVisible="{Binding RolPuedeCocina}" IsEnabled="{Binding PuedeAbrirCocina}" Command="{Binding AbrirCocinaCommand}" HorizontalAlignment="Stretch" />
                    <Button Classes="navegacion-cocina" Content="Caja y recuperación" Padding="12,10" IsVisible="{Binding RolPuedeRecuperarCaja}" IsEnabled="{Binding PuedeAbrirRecuperacionCaja}" Command="{Binding AbrirRecuperacionCajaCommand}" HorizontalAlignment="Stretch" />
                    <Button Classes="navegacion-cocina" Content="Inventario (consulta)" Padding="12,10" IsVisible="{Binding RolPuedeInventario}" IsEnabled="{Binding PuedeAbrirInventario}" Command="{Binding AbrirInventarioCommand}" HorizontalAlignment="Stretch" />
                    <Button Classes="navegacion-cocina" Content="Reservaciones" Padding="12,10" IsVisible="{Binding RolPuedeReservaciones}" IsEnabled="{Binding PuedeAbrirReservaciones}" Command="{Binding AbrirReservacionesCommand}" HorizontalAlignment="Stretch" />
                    <Button Classes="navegacion-cocina" Content="Reporte de ventas" Padding="12,10" IsVisible="{Binding RolPuedeReporteVentas}" IsEnabled="{Binding PuedeAbrirReporteVentas}" Command="{Binding AbrirReporteVentasCommand}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipalBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Rol}" FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}" TextWrapping="Wrap" />
                    <Button Content="Cerrar sesión" Command="{Binding SolicitarCierreCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Grid>
            </Panel>
        </Border>
        <Grid Grid.Column="2" IsVisible="{Binding !MostrandoModulo}" RowDefinitions="Auto,Auto,*" Margin="20,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Mapa de mesas" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                <TextBlock Text="Salón principal · Consulta de mesas" Foreground="{StaticResource TextoSecundarioBrush}" />
                <WrapPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4"><Border Width="10" Height="10" Background="#27E7A0" CornerRadius="5" /><TextBlock Text="{Binding MesasLibres, StringFormat='{}{0} libres'}" Foreground="{StaticResource TextoPrincipalBrush}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4"><Border Width="10" Height="10" Background="#FF5B66" CornerRadius="5" /><TextBlock Text="{Binding MesasOcupadas, StringFormat='{}{0} ocupadas'}" Foreground="{StaticResource TextoPrincipalBrush}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4"><Border Width="10" Height="10" Background="#FFBF36" CornerRadius="5" /><TextBlock Text="{Binding MesasReservadas, StringFormat='{}{0} reservadas'}" Foreground="{StaticResource TextoPrincipalBrush}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4"><Border Width="10" Height="10" Background="#32D9F4" CornerRadius="5" /><TextBlock Text="{Binding MesasAgrupadas, StringFormat='{}{0} agrupadas'}" Foreground="{StaticResource TextoPrincipalBrush}" /></StackPanel>
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding EstadoConexion, Converter={StaticResource ConexionColor}}" />
                    <TextBlock Text="{Binding EstadoConexion}" MaxWidth="240" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Classes="primario" Content="Agrupar mesas existentes" IsEnabled="{Binding PuedeIniciarGrupo}" Command="{Binding IniciarGrupoCommand}" HorizontalAlignment="Right" ToolTip.Tip="Unir mesas libres existentes en un grupo" />
            </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="0,8,0,10">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding MensajeAccion}" IsVisible="{Binding !SeleccionandoGrupo}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                    <Button Content="He revisado las mesas" IsVisible="{Binding ResultadoIncierto}" IsEnabled="{Binding PuedeReconocer}" Command="{Binding ReconocerIncertidumbreCommand}" />
                    <Border IsVisible="{Binding SeleccionandoGrupo}" Background="{StaticResource FondoPanelBrush}"
                            BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <WrapPanel>
                            <StackPanel Spacing="3" Margin="0,0,18,4" VerticalAlignment="Center">
                                <TextBlock Text="Unir mesas existentes" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                                <TextBlock Text="{Binding MensajeAccion}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" MaxWidth="350" />
                                <TextBlock Text="{Binding ContadorGrupo}" Foreground="{StaticResource TextoPrincipalBrush}" />
                                <TextBlock Text="{Binding SeleccionGrupoTexto}" Foreground="{StaticResource TextoSecundarioBrush}" TextWrapping="Wrap" MaxWidth="350" />
                            </StackPanel>
                            <Button Classes="primario" Content="Crear grupo" IsEnabled="{Binding PuedeConfirmarGrupo}" Command="{Binding CrearGrupoCommand}" Margin="0,2,8,2" VerticalAlignment="Center" />
                            <Button Content="Cancelar" Command="{Binding CancelarGrupoCommand}" Margin="0,2,0,2" VerticalAlignment="Center" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Mesas}" HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MesaDto">
                            <ToggleButton x:Name="MesaButton" Theme="{StaticResource MesaButtonTheme}" Classes="mesa" Width="180" Margin="0,0,10,10" Padding="0" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Numero, StringFormat='Mesa {0}'}"
                                    Command="{Binding #Root.((vm:MesasViewModel)DataContext).SeleccionarMesaCommand}"
                                    CommandParameter="{Binding}">
                            <ToggleButton.IsChecked>
                                <MultiBinding Converter="{StaticResource MesaSeleccionadaConverter}" Mode="OneWay">
                                    <Binding />
                                    <Binding Path="#Root.((vm:MesasViewModel)DataContext).MesaSeleccionada" />
                                    <Binding Path="#Root.((vm:MesasViewModel)DataContext).MesasSeleccionadasGrupo" />
                                </MultiBinding>
                            </ToggleButton.IsChecked>
                            <Border Classes="tarjeta" Classes.seleccionada="{Binding #MesaButton.IsChecked}"
                                    Classes.enfocada="{Binding #MesaButton.IsKeyboardFocusWithin}"
                                    MinHeight="126" Background="{StaticResource FondoPanelBrush}" BorderThickness="1" CornerRadius="7">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
                                    </Transitions>
                                </Border.Transitions>
                                <Grid RowDefinitions="4,*">
                                    <Border Grid.Row="0" Background="{Binding Estado, Converter={StaticResource EstadoColor}}" CornerRadius="7,7,0,0" />
                                    <StackPanel Grid.Row="1" Margin="12,10" Spacing="5">
                                        <TextBlock Text="{Binding Numero, StringFormat='Mesa {0:00}'}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                                        <TextBlock Text="{Binding Capacidad, StringFormat='Capacidad: {0} personas'}" Foreground="{StaticResource TextoSecundarioBrush}" />
                                        <TextBlock Text="{Binding Estado, StringFormat='Estado: {0}'}" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipalBrush}" />
                                        <TextBlock Text="{Binding GrupoTexto}" FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}" />
                                        <TextBlock Text="{Binding ProximaReservacion.InicioLocalTexto, StringFormat='Reserva: {0} · hora Managua'}"
                                                   IsVisible="{Binding ProximaReservacion}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#FFBF36" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <ScrollViewer Grid.Column="1" Width="226" IsVisible="{Binding HayMesaSeleccionada}"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Border Margin="8,0,0,0" Padding="14" VerticalAlignment="Top"
                    Background="{StaticResource FondoPanelBrush}"
                    BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="9">
                    <TextBlock Text="Detalle de mesa" Foreground="{StaticResource TextoSecundarioBrush}" FontSize="13" />
                    <TextBlock Text="{Binding DetalleTitulo}" Foreground="{StaticResource TextoPrincipalBrush}" FontSize="21" FontWeight="Bold" />
                    <TextBlock Text="{Binding DetalleCapacidad}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DetalleEstado}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                                         <TextBlock Text="{Binding DetalleGrupo}" Foreground="{StaticResource TextoPrincipalBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding MesaSeleccionada.ProximaReservacion.InicioLocalTexto, StringFormat='Próxima reserva: {0} · Managua'}"
                               IsVisible="{Binding MesaSeleccionada.ProximaReservacion}" Foreground="#FFBF36" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding AyudaAcciones}" Foreground="{StaticResource TextoSecundarioBrush}" TextWrapping="Wrap" FontSize="12" />
                     <Button Classes="primario" Content="Ver cuenta y borrador" IsEnabled="{Binding PuedeAbrirCuenta}" Command="{Binding AbrirCuentaCommand}" HorizontalAlignment="Stretch" />
                     <Button Content="Reservar" IsEnabled="{Binding PuedeReservar}" Command="{Binding ReservarCommand}" HorizontalAlignment="Stretch" />
                     <Button Content="Ocupar" IsEnabled="{Binding PuedeOcupar}" Command="{Binding OcuparCommand}" HorizontalAlignment="Stretch" />
                      <Button Content="Liberar" IsEnabled="{Binding PuedeLiberar}" Command="{Binding SolicitarLiberacionCommand}" HorizontalAlignment="Stretch" />
                      <Button Content="Cerrar grupo" IsEnabled="{Binding PuedeCerrarGrupo}" Command="{Binding SolicitarCierreGrupoCommand}" HorizontalAlignment="Stretch" />
                    <Button Content="Cerrar detalle" Command="{Binding CerrarDetalleCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                </StackPanel>
            </Border>
            </ScrollViewer>
            </Grid>
        </Grid>
        <ContentControl Grid.ColumnSpan="3" IsVisible="{Binding MostrandoPedidos}" Content="{Binding PedidosActual}" ZIndex="90">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:PedidosSalonViewModel"><views:PedidosSalonView /></DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <ContentControl Grid.ColumnSpan="3" IsVisible="{Binding MostrandoCocina}" Content="{Binding CocinaActual}" ZIndex="90">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:CocinaViewModel"><views:CocinaView /></DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <ContentControl Grid.ColumnSpan="3" IsVisible="{Binding MostrandoRecuperacionCaja}" Content="{Binding RecuperacionCajaActual}" ZIndex="90">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:CajaRecoveryViewModel"><views:CajaRecoveryView /></DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <ContentControl Grid.ColumnSpan="3" IsVisible="{Binding MostrandoInventario}" Content="{Binding InventarioActual}" ZIndex="90">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:InventarioLecturaViewModel"><views:InventarioLecturaView /></DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <ContentControl Grid.ColumnSpan="3" IsVisible="{Binding MostrandoReservaciones}" Content="{Binding ReservacionesActual}" ZIndex="90">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ReservacionesViewModel"><views:ReservacionesView /></DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <ContentControl Grid.ColumnSpan="3" IsVisible="{Binding MostrandoReporteVentas}" Content="{Binding ReporteVentasActual}" ZIndex="90">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ReporteVentasViewModel"><views:ReporteVentasView /></DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
        <Border Grid.ColumnSpan="3" Background="#B0000000" IsVisible="{Binding ConfirmarCierreGrupo}" ZIndex="110">
            <Border Width="380" Padding="24" CornerRadius="10" Background="{StaticResource FondoPanelBrush}" BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="¿Cerrar grupo?" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <TextBlock Text="{Binding DetalleGrupo}" TextWrapping="Wrap" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <TextBlock Text="La API verificará si el grupo tiene una cuenta pendiente." TextWrapping="Wrap" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancelar" Command="{Binding CancelarCierreGrupoCommand}" />
                        <Button Classes="primario" Content="Cerrar grupo" Command="{Binding CerrarGrupoCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border Grid.ColumnSpan="3" Background="#B0000000" IsVisible="{Binding ConfirmarLiberacion}" ZIndex="110">
            <Border Width="380" MaxWidth="380" Padding="24" CornerRadius="10" Background="{StaticResource FondoPanelBrush}"
                    BorderBrush="{StaticResource BordePanelBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="¿Liberar mesa?" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <TextBlock Text="{Binding DetalleTitulo}" FontWeight="SemiBold" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <TextBlock Text="Confirma solo si deseas dejar esta mesa libre. La API verificará si tiene una cuenta pendiente." TextWrapping="Wrap" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancelar" Command="{Binding CancelarLiberacionCommand}" />
                        <Button Classes="primario" Content="Liberar mesa" Command="{Binding LiberarCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border Grid.ColumnSpan="3" Background="#B0000000" IsVisible="{Binding ConfirmarCierre}" ZIndex="100">
            <Border Width="380" Padding="24" CornerRadius="10" Background="{StaticResource FondoPanelBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16" KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="¿Cerrar sesión?" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <TextBlock Text="Se detendrá la consulta de mesas y volverá al inicio de sesión." TextWrapping="Wrap" Foreground="{StaticResource TextoPrincipalBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancelar" Command="{Binding CancelarCierreCommand}" />
                        <Button Content="Cerrar sesión" Command="{Binding CerrarSesionCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
