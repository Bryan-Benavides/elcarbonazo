<UserControl x:Class="ElCarbonazo.Desktop.Views.LoginView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ElCarbonazo.Desktop.ViewModels"
             x:DataType="vm:LoginViewModel"
             Background="{StaticResource ColorHuesoBrush}">
    <Grid Margin="32">
        <Border Width="460"
                Padding="36"
                CornerRadius="20"
                Background="{StaticResource ColorBeigeBrush}"
                BorderBrush="{StaticResource ColorVinoBrush}"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="18">
                <Border Width="76"
                        Height="76"
                        CornerRadius="38"
                        Background="{StaticResource ColorVinoBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="EC"
                               Foreground="White"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="El Carbonazo"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource ColorVinoBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Sistema de mesas y atención"
                               Foreground="{StaticResource ColorCarbónBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Text="Nombre de usuario"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorCarbónBrush}" />
                    <TextBox Text="{Binding Nombre, Mode=TwoWay}"
                             PlaceholderText="Ingrese su nombre"
                             Background="{StaticResource ColorHuesoBrush}"
                             Foreground="{StaticResource ColorCarbónBrush}" />
                </StackPanel>

                <StackPanel Spacing="7">
                    <TextBlock Text="Contraseña"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ColorCarbónBrush}" />
                    <TextBox Text="{Binding Contrasena, Mode=TwoWay}"
                             PasswordChar="●"
                             PlaceholderText="Ingrese su contraseña"
                             Background="{StaticResource ColorHuesoBrush}"
                             Foreground="{StaticResource ColorCarbónBrush}" />
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ColorVinoBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center" />

                <Button Content="Ingresar"
                        Command="{Binding LoginCommand}"
                        Background="{StaticResource ColorVinoBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <ProgressBar IsVisible="{Binding IsBusy}"
                             IsIndeterminate="True"
                             Height="4" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
